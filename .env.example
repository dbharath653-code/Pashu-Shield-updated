# Pashu-Shield deployment reference. Never commit real values.
DATABASE_URL=sqlite:///var/data/pashu-shield/animal_health.db
SIH_DB_PATH=/var/data/pashu-shield/animal_health.db
SIH_SECRET_KEY=replace-with-a-random-secret
JWT_SECRET=replace-with-a-random-secret
REDIS_URL=
WEBSOCKET_AUTH_SECRET=
CORS_ORIGINS=
APP_BASE_URL=https://your-backend.example

# Unified notifications
SMS_PROVIDER=
SMS_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_TIMEOUT_SECONDS=10
SMS_MAX_RETRIES=2
SMS_RATE_LIMIT_PER_MINUTE=60
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
PUSH_API_URL=
PUSH_API_KEY=

# Maps and language services
MAP_PROVIDER=
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
TRANSLATION_PROVIDER=builtin
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# ML and telephony
SIH_ML_BACKEND=http://127.0.0.1:8000
TELEPHONY_PROVIDER=mock
IVR_PHONE_NUMBER=7382210251
PBX_WEBHOOK_SECRET=
PBX_ALLOWED_IPS=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_API_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Visit GPS sharing
VISIT_TRACKING_MAX_MINUTES=120
IVR_LOCATION_SMS_ENABLED=false
