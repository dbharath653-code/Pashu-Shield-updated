# Pashu-Shield voice gateway (PBX host) configuration.
# Copy to /etc/pashu-pbx/pbx.env (root-only, chmod 600), fill in, then run
# pbx/install.sh. NEVER commit the filled file to Git.
#
# Values marked REQUIRED must be provided by you / your carrier. Values with
# defaults shown can usually stay as-is.

# ---------- Pashu-Shield backend (Render) ----------
# Public HTTPS base of the existing backend, e.g. https://pashu-shield.onrender.com
PASHU_BACKEND_URL=
# MUST equal the backend's PBX_WEBHOOK_SECRET env var (generate: secrets.token_hex(32))
PBX_WEBHOOK_SECRET=

# ---------- Helpline DID ----------
# Last 10 digits of the helpline the trunk delivers (fixed: 7382210251).
PBX_DID_LAST10=7382210251

# ---------- Carrier SIP trunk (provided by the carrier) ----------
# Trunk signalling host/IP and port, e.g. sip.carrier.example / 203.0.113.10 : 5060
SIP_TRUNK_HOST=
SIP_TRUNK_PORT=5060
# Trunk auth username/password from the carrier (also used for vet-leg dialling)
SIP_USERNAME=
SIP_PASSWORD=
# Comma-separated carrier signalling IPs accepted for inbound SIP (SECURITY:
# inbound 5060 is firewalled to these). Ask the carrier for the SBC IP/range.
CARRIER_SIP_IPS=
# Set true if the carrier requires the PBX to REGISTER (most DID-termination
# trunks in India are static IP-auth; leave false unless told otherwise).
PBX_SIP_REGISTER=false
# Tells the heartbeat how to verify trunk state (match PBX_SIP_REGISTER).
PBX_TRUNK_STATIC=true
# PJSIP endpoint name for vet legs (must match pjsip.conf; keep default).
PBX_TRUNK_ENDPOINT=carrier-trunk
PBX_HEARTBEAT_TRUNK=carrier-trunk
# Vet-leg number format expected by the carrier: national (10-digit, default),
# e164 (+91...), or raw.
PBX_VET_DIAL_FORMAT=national

# ---------- Media / network ----------
RTP_PORT_START=10000
RTP_PORT_END=10100
# Behind NAT? Set the host's public IP + local nets (blank = public-IP host).
PBX_PUBLIC_IP=
PBX_LOCALNETS=
# TLS/SRTP: enable ONLY if the carrier supports it (most IN trunks don't).
PBX_TLS_CERT=
PBX_TLS_KEY=
PBX_SRTP=
PBX_ALLOW_G722=

# ---------- Prompts / TTS ----------
PBX_SOUNDS_DIR=/var/lib/asterisk/sounds/pashu
# Offline TTS for dynamic IVR prompts. {voice} {textfile} {wav} {lang} expand.
# Default engine (install.sh apt-installs espeak-ng). Indic-language quality is
# robotic but intelligible; the recommended upgrade is pre-recorded prompts
# (see pbx/README.md) or a TTS sidecar - swap this command only.
PBX_TTS_COMMAND=espeak-ng -v {voice} -s 150 -f {textfile} -w {wav}
PBX_TTS_VOICE_EN=en
PBX_TTS_VOICE_TE=te
PBX_TTS_VOICE_HI=hi
PBX_TTS_VOICE_MR=mr

# ---------- Recording (vet legs only, consent-gated) ----------
# Master switch. Per-call recording ALSO requires the farmer's in-call
# consent (press 1); without it the PBX never records, even if true.
PBX_RECORDING_ENABLED=true
PBX_RECORDING_DIR=/var/spool/asterisk/monitor
# Retention for MixMonitor files (install.sh cron; days).
PBX_RECORDING_RETENTION_DAYS=30

# ---------- Misc ----------
PBX_AGI_LOG=/var/log/asterisk/pashu_ivr.log
