# PashuMitra Backend Environment
# Copy to .env for local dev (never commit real secrets).
SIH_SECRET_KEY=change-me-in-production
SIH_ML_BACKEND=http://localhost:8000

# Optional: override SQLite location (Render sets this to the persistent disk).
# SIH_DB_PATH=/var/data/pashu-shield/animal_health.db

# Optional: comma-separated origins for split frontend/backend hosting.
# Leave empty for default same-origin deployment (Flask serves the frontend).
# CORS_ORIGINS=https://your-frontend-host

# Local dev server: PORT defaults to 5001; FLASK_DEBUG defaults on for local port.
# PORT=5001
# FLASK_DEBUG=true

# Public base URL of this backend (used for IVR SMS location links).
# APP_BASE_URL=https://your-backend-host

# ---- IVR Reporting Channel (extension) ----
# Official Pashu-Shield helpline farmers call. Fixed production number; the
# application defaults to it, so this only needs setting when it changes.
IVR_PHONE_NUMBER=7382210251

# Telephony transport: mock (dev/tests, default) or sip (self-hosted Asterisk
# PBX voice gateway in pbx/, fed by a carrier SIP trunk). No Twilio/Exotel
# SDKs or credentials are used in either mode.
# TELEPHONY_PROVIDER=mock

# ---- Self-hosted voice gateway (TELEPHONY_PROVIDER=sip) ----
# Shared secret the PBX must present on every gateway/webhook call. REQUIRED
# in sip mode; gateway auth fails closed when unset. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# MUST equal the PBX host's PBX_WEBHOOK_SECRET in /etc/pashu-pbx/pbx.env.
# PBX_WEBHOOK_SECRET=
# Optional comma-separated PBX egress IPs allowed on /api/ivr/gateway/*.
# PBX_ALLOWED_IPS=
# Heartbeat freshness window (seconds) for pbx_healthy.
# PBX_HEARTBEAT_STALE_SECONDS=300

# Veterinarian working hours (IST, 24h) for automatic availability.
# Vets with an explicit availability_status override these hours.
# VET_WORK_START_HOUR=8
# VET_WORK_END_HOUR=20
# VET_MAX_ACTIVE_CASES=10
# VET_LIVE_CALL_STALE_MINUTES=30

# Telephony provider abstraction: mock | twilio | exotel | plivo
TELEPHONY_PROVIDER=mock
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_API_URL=

# Call recording (requires farmer consent preamble)
IVR_RECORDING_ENABLED=true
IVR_RECORDING_CONSENT_REQUIRED=true

# AI Summarization (rule-based fallback if no keys; no hallucination)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
IVR_AI_ENABLED=true
IVR_STT_PROVIDER=whisper

# Location (GPS via SMS link requires SMS gateway)
IVR_LOCATION_SMS_ENABLED=false

# Security & limits
IVR_RATE_LIMIT_PER_MINUTE=60
IVR_MAX_CALL_DURATION_SECONDS=600
IVR_WEBHOOK_TIMEOUT_SECONDS=15

# Language & survey
IVR_DEFAULT_LANGUAGE=en
IVR_SURVEY_MAX_RETRIES=3
IVR_DUPLICATE_WINDOW_HOURS=24
IVR_ASYNC_ENABLED=true
